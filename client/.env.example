# Signaling server backend URL (Render URL in production, localhost in development)
VITE_SERVER_URL=http://localhost:5000

# STUN/TURN ICE Servers
# Default Google STUN Server:
VITE_ICE_SERVERS=stun:stun.l.google.com:19302

# Metered.ca TURN Server Credentials (Required for NAT / Firewall Traversal in Production)
# Get free credentials at: https://www.metered.ca/tools/openrelay/
VITE_TURN_SERVER_URL=turn:relay.metered.ca:80,turn:relay.metered.ca:443?transport=tcp
VITE_TURN_USERNAME=your-metered-username
VITE_TURN_CREDENTIAL=your-metered-credential

# Supabase Auth & Database (Public Anon Key ONLY - Never put service_role key here)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
